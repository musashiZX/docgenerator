# Copy to .env in this folder (repo root) and fill in values.
# .env is gitignored — never commit real keys.
#
# Used by:
#   start-java.ps1 / start-java.sh  → Java DocIO backend + React frontend
#   start.ps1 / start.sh            → Python backend + React frontend (legacy)

# ── Syncfusion ───────────────────────────────────────────────────────────────
# Generate at: https://www.syncfusion.com/account/downloads
#
# ONE key works for both Java DocIO and the React Document Editor IF your
# license includes both editions:
#   • Document SDK        (Java DocIO — server-side .docx)
#   • DOCX Editor SDK     (React @syncfusion/ej2-react-documenteditor)
# Or use Enterprise Edition (all products).
#
# Use the key for the volume version matching your packages (e.g. v33.x).
SYNCFUSION_LICENSE_KEY=

# Frontend alias — optional; start-java copies SYNCFUSION_LICENSE_KEY here if empty
VITE_SYNCFUSION_LICENSE=

# ── LLM providers (docx4j-agent-server) ──────────────────────────────────────
# Provider selection: "openai" (default) or "gemini". See
# docx4j-agent-server/USER_GUIDE.md §8 for the full provider table.
LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
