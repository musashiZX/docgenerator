# Copy to .env in this folder (project root) and fill in one provider.
# .env is gitignored — never commit real keys.

# ── LLM provider ──────────────────────────────────────────────────────────
# "openai" (default) or "gemini". See USER_GUIDE.md for the full table.
LLM_PROVIDER=

# OpenAI (used when LLM_PROVIDER is unset or "openai")
OPENAI_API_KEY=

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# ── OnlyOffice "Manual Editing" ─────────────────────────────────────────────
# See docs/ONLYOFFICE.md. Defaults work for local dev with
# `docker compose -f docker/onlyoffice-compose.yml up -d` and no changes here.
# Set these for a shared/production deployment.
ONLYOFFICE_DOCUMENT_SERVER_URL=
ONLYOFFICE_CALLBACK_BASE_URL=
ONLYOFFICE_JWT_SECRET=
