# DocIO reads secrets from the repo-root .env (one level up).
#
#   cp ../.env.example ../.env
#   # edit ../.env and set SYNCFUSION_LICENSE_KEY=... and OPENAI_API_KEY=...#
# Spring Boot also auto-loads ../.env via spring.config.import in application.yml.
# You do NOT need a separate file here unless you want local overrides:
#
#   SYNCFUSION_LICENSE_KEY=override-for-this-machine-only
