<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.5</version>
    <relativePath/>
  </parent>

  <groupId>com.docgen</groupId>
  <artifactId>doc-agent-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>doc-agent-server</name>
  <description>Word document AI agent — Syncfusion DocIO backend</description>

  <properties>
    <java.version>21</java.version>
    <syncfusion.version>29.1.33</syncfusion.version>
  </properties>

  <repositories>
    <repository>
      <id>syncfusion-public</id>
      <name>Syncfusion Maven Repository</name>
      <url>https://jars.syncfusion.com/repository/maven-public/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>com.syncfusion</groupId>
      <artifactId>syncfusion-docio</artifactId>
      <version>${syncfusion.version}</version>
    </dependency>
    <dependency>
      <groupId>com.syncfusion</groupId>
      <artifactId>syncfusion-javahelper</artifactId>
      <version>${syncfusion.version}</version>
    </dependency>
    <dependency>
      <groupId>com.syncfusion</groupId>
      <artifactId>syncfusion-licensing</artifactId>
      <version>${syncfusion.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
