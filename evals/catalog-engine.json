      "expect": {
        "outcome": "applied",
        "structure": {
          "inserted_min": 2
        },
        "text_present": [
          "ENGINE LINE ONE",
          "ENGINE LINE TWO"
        ],
        "unchanged": [
          "dg_p12",
          "dg_p13"
        ]
      },
      "op_type": "insert"
    },
