{
  "_comment": "Engine-tier evals: hand-written mutation batches, NO LLM. Tests the applier + validator + hash guard deterministically. Free, fast, CI-able. Run: python evals/run.py --catalog evals/catalog-engine.json",
  "api": "http://localhost:8081",
  "cases": [
    {
      "id": "eng-modify-paragraph",
      "category": "engine-modify",
      "doc": "XYZ-Training-and-Instruction-Program-version0.docx",
      "golden": "docs/XYZ-Training-and-Instruction-Program-version0.docx",
      "prompt": "(engine) version 1.0 -> 1.1",
      "batch": {
        "schema_version": 1,
        "explanation": "engine test",
        "mutations": [
          {
            "op": "modify",
            "target_id": "dg_p3",
            "old_text": "1.0",
            "occurrence": 0,
            "new_text": "1.1"
          }
        ]
      },
      "expect": {
        "outcome": "applied",
        "blocks": {
          "dg_p3": {
            "text_equals": "Version: 1.1"
          }
        },
        "unchanged": [
          "dg_p2",
          "dg_p4"
        ]
      },
      "op_type": "modify"
    },
